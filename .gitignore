# Track source, configuration, documentation and curated experiment summaries.
# Keep all original datasets/results on disk; publish summaries under experiments/.

# Python environments, caches and build/test outputs
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.venv/
venv/
.tox/
build/
dist/
*.egg-info/
htmlcov/
.coverage*
coverage.xml

# Raw runs, training/evaluation products and machine-local logging
/artifacts/
/outputs/
/multirun/
/res/
/results/
/logs/
/log/
/reports/
/plots/
/figures/
/checkpoints/
wandb/
mlruns/
.hydra_config_snapshots/
/research/logs/
*.log
*.log.*
*.out
*.pid

# Dataset/ is storage plus compatibility shims; only its Python files are source.
/dataset/*
!/dataset/*.py
*.csv
*.tsv
*.parquet
*.feather
*.arrow
*.npy
*.npz
*.h5
*.hdf5
*.pkl
*.pickle
*.bin
*.sqlite
*.sqlite3
*.db

# Weights, archives and generated visualizations
*.ckpt
*.pt
*.pth
*.safetensors
*.onnx
*.wandb
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.bz2
*.xz
*.7z
*.rar
*.png
*.jpg
*.jpeg
*.pdf

# Machine-specific evidence remains intact locally and in the baseline tag.
/research/baseline/
/research/validation.json
/docs/deployment/
/docs/migration/*.json
/docs/migration/source_records/
/docs/restructure_map.json

# Public experiment summaries: text/config only, including per-seed metrics.
# Directory exceptions are required so Git can reach nested config snapshots.
/experiments/**
!/experiments/**/
!/experiments/**/*.md
!/experiments/**/*.csv
!/experiments/**/*.json
!/experiments/**/*.yaml
!/experiments/**/*.yml

# Raw per-day results and training traces do not belong in the summary tree.
/experiments/**/portfolio_return.csv
/experiments/**/qlib_report.csv
/experiments/**/daily_*.csv
/experiments/**/*_daily.csv
/experiments/**/metrics.csv
/experiments/**/epoch_metrics.csv
/experiments/**/training_progress.json

# Private settings and credentials; these take precedence over summary exceptions.
.env
.env.*
!.env.example
.deployment/
.secrets/
.credentials/
.ssh/
.aws/
.codex/
.agents/
*.local.env
*.local.json
*.local.yaml
*.local.yml
*.pem
*.key
*.p12
*.pfx
*.keystore
*.token
*.secret
id_rsa*
id_ed25519*
credentials.json
credentials.*.json
service-account*.json
service_account*.json

# Editor/OS local state
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
